# Agent working-session logs — private working notes, not for the public repo.
# See agent-session/README.md for the convention. README itself stays tracked.
agent-session/*
!agent-session/README.md

# Frontend generated artifacts
web/node_modules/
web/dist/
web/coverage/

# Local-machine-only env overrides (e.g. VITE_RELAY_BASE_URL for
# pointing a dev server at a local relay instead of production)
web/.env.local
web/.env.*.local

# Git worktrees (per-agent isolated working directories)
.worktrees/
worktree/

# Playwright MCP tool artifacts (page snapshot cache)
.playwright-mcp/

# Private deploy notes — server IPs, SSH key paths, access details.
# This repo is going open source; none of this belongs in it.
deploy/server-notes.md

# Local Cloudflare tunnel configs for phone/manual dev testing.
.cloudflared/
